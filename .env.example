EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Ambiente de la app: development muestra los logs de depuración; production los silencia.
# Si queda vacío: development en builds debug (Metro) y production en builds release.
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_API_URL=https://heernandezdev.com/buses/api/v1
# Opcional: si queda vacío se deriva de API_URL, cambiando http(s) por ws(s) y agregando /live.
EXPO_PUBLIC_WS_URL=

# Servicio de caminata heredado (Viaje ya usa POST /journeys/plan en el backend).
# No se necesita esta variable para el nuevo planificador; el mapa conserva su configuración en app.json.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Logs de tiempos de apertura. Solo aplican en development; false los desactiva también ahí.
EXPO_PUBLIC_STARTUP_LOGS=true
