EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_USE_DUMMY_DATA=true
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
# Opcional: si queda vacío se deriva de API_URL, cambiando http(s) por ws(s) y agregando /live.
EXPO_PUBLIC_WS_URL=

# Servicio de caminata heredado (Viaje ya usa POST /journeys/plan en el backend).
# No se necesita esta variable para el nuevo planificador; el mapa conserva su configuración en app.json.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Logs temporales de tiempos de apertura; false los desactiva.
EXPO_PUBLIC_STARTUP_LOGS=true
